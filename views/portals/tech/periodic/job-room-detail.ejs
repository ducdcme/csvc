<div class="content mt-2">
    <h4 id="jobTitle" class="job-title"></h4>
    <h5 id="jobSummary"></h5>

    <!-- ===== SECTION 1: FLOOR + ROOM ===== -->
    <div class="card p-2 mb-2">

        <div id="locationInfo" class="location-info"></div>
        <div id="floorTabs" class="mb-2"></div>
        <div id="roomGrid" class="room-grid"></div>
        <div id="floorProgress" class="floor-progress"></div>
        <div class="floor-nav">

            <button id="btnPrevFloor">←</button>

            <div id="floorList" class="floor-list"></div>

            <button id="btnNextFloor">→</button>

        </div>

    </div>

    <!-- ===== SECTION 2: ROOM DETAIL ===== -->
    <div id="breadcrumb" class="mb-2 text-muted"></div>
    <div id="roomDetail" class="card p-2 mb-2" style="display:none">

        <h6 id="roomTitle"></h6>

        <!-- ===== ROOM IMAGE ===== -->
        <div id="roomImageSection" class="card p-2 mb-2">

            <h6>Ảnh tổng thể phòng</h6>

            <!-- EDIT MODE -->
            <div id="roomUploadSection">

                <div class="upload-box" onclick="triggerUpload('roomImageInput')">
                    📷 Chụp ảnh checkin phòng
                </div>

                <input type="file" id="roomImageInput" accept="image/*" hidden>

                <div id="preview"></div>

            </div>

            <!-- VIEW MODE -->
            <div id="roomImageView" style="display:none"></div>

        </div>

         <!-- ===== ASSET ===== -->
        <div id="assetList"></div>

        <!-- ===== ACTION ===== -->
        <div id="roomActionSection">

            <button class="btn btn-primary mt-2" onclick="showConfirm()">Hoàn thành phòng</button>

            <div id="confirmWrap" style="display:none;margin-top:10px;">

                <div class="text-danger">Xác nhận đã kiểm tra xong phòng?</div>

                <button class="btn btn-success" onclick="confirmDoneRoom()">Xác nhận</button>

                <button class="btn btn-secondary" onclick="cancelConfirm()">Hủy</button>

            </div>

        </div>

    </div>
    <div id="imgModal" class="preview-modal">
        <img id="imgPreviewLarge">
    </div>
</div>

<style>
    .floor-progress {
        margin-top: 8px;
        font-size: 14px;
    }

    .location-info {
        font-weight: bold;
        margin-bottom: 6px;
    }

    .floor-footer {
        display: flex;
        justify-content: space-between;
        margin-top: 10px;
    }

    .btn-next-floor {
        background: none;
        border: none;
        color: #0d6efd;
        font-weight: bold;
    }

    .floor-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 10px;
    }

    .floor-list {
        display: flex;
        gap: 6px;
    }

    .floor-item {
        padding: 6px 10px;
        border: 1px solid #ccc;
        border-radius: 6px;
        cursor: pointer;
        background: #fff;
    }

    .floor-item.active {
        background: #0d6efd;
        color: #fff;
    }

    .room-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 6px;
    }

    .room {
        padding: 8px;
        border: 1px solid #ccc;
        text-align: center;
        cursor: pointer;
        border-radius: 6px;
    }

    .room-active {
        border: 2px solid #0d6efd;
    }

    .room.done {
        background: #d4edda;
    }

    .room.pending {
        background: #fff;
    }

    .room.error {
        background: #f8d7da;
    }

    .room.disabled {
        background: #e9ecef;
        color: #999;
        pointer-events: none;
    }

    /* ===== ASSET ITEM ===== */
    .asset-item {
        display: flex;
        justify-content: space-between;
        padding: 10px;
        border-bottom: 1px solid #eee;
        cursor: pointer;
    }

    .asset-item.active {
        background: #f0f6ff;
    }

    .asset-left {
        width: 40px;
    }

    .asset-name {
        flex: 1;
    }

    .asset-right {
        color: #666;
    }

    /* ===== FORM ===== */
    .repair-form {
        background: #e7f1ff;
        border: 1px solid #0d6efd;
        border-top: none;
        padding: 10px;
        margin-bottom: 8px;
        border-radius: 0 0 6px 6px;
    }

    /* ===== FORM TITLE ===== */
    .repair-title {
        font-size: 13px;
        color: #555;
        margin-bottom: 6px;
    }

    /* ===== INPUT ===== */
    .repair-input {
        width: 100%;
        min-height: 60px;
        margin-bottom: 8px;
    }

    /* ===== ACTION ===== */
    .repair-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .asset-item.asset-ok{
        border-left:4px solid #198754;
    }

    .asset-item.asset-error{
        border-left:4px solid #dc3545;
        background:#fff5f5;
    }
    .room-view-image{

        width:140px;

        border-radius:8px;

        cursor:pointer;

        border:1px solid #ddd;

    }
</style>

<script src="/js/portals/tech/periodic/job-room-detail.js"></script>