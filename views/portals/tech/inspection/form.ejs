<div class="content">
    <%- include('../../../partials/page-header', { title: 'BÁO CÁO' , subtitle: 'Ngăn ngừa rủi ro hệ thống kỹ thuật' ,
        breadcrumb: '' }) %>
        <div class="inspection-page">

            <!-- ================= FORM VIEW ================= -->
            <div id="view-form">

                <!-- Header -->
                <div class="view-header">

                    <div class="header-top">
                        <button onclick="InspectionPage.goBack()">←</button>
                        <h3>KIỂM TRA NGĂN NGỪA RỦI RO </h3>
                    </div>

                    <div class="header-info">
                        <div id="zone-label" class="zone"></div>
                        <div id="inspection-time" class="time"></div>
                        <div id="inspection-status" class="status"></div>
                    </div>

                </div>

                <!-- Form content render từ JS -->
                <div id="form-container"></div>

                <!-- Note -->
                <div style="margin-top:15px;">
                    <textarea id="inspection-note" placeholder="Ghi chú tổng..."></textarea>
                </div>

                <!-- Late reason -->
                <div id="late-box" style="display:none; margin-top:10px;">
                    <textarea id="late-reason" placeholder="Lý do gửi muộn..."></textarea>
                </div>

                <!-- Submit -->
                <div style="margin-top:15px;">
                    <button id="submit-btn" class="submit" onclick="InspectionPage.submit()">
                        Gửi báo cáo
                    </button>
                </div>
                <!-- Error -->
                <div id="submit-error" style="color:red; margin:10px 0;"></div>

            </div>

            <!-- ================= VIEW MODE ================= -->
            <div id="view-view" style="display:none;">
                <div id="view-container"></div>
            </div>

            <!-- ================= SUCCESS ================= -->
            <div id="view-success" style="display:none;">
                <div class="success-box">
                    <h2>✅ Đã gửi báo cáo thành công</h2>
                    <p>Đang chuyển về trang tổng...</p>
                </div>
            </div>

        </div>

        <!-- ================= IMAGE MODAL ================= -->
        <div id="img-modal" class="img-modal" onclick="InspectionPage.closeImage()">
            <img id="img-modal-src" />
        </div>
</div>

<!-- ================= CSS (MIN) ================= -->
<style>
    /* ===== VIEW CONTAINER ===== */
    html {
        scroll-behavior: smooth;
    }

    .view-container {
        padding: 12px;
        font-size: 14px;
        color: #222;
    }

    /* ===== HEADER ===== */
    .view-header {
        background: #fff;
        padding: 12px;
        border-radius: 10px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
        margin-bottom: 12px;
    }

    .header-top {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .header-top h3 {
        margin: 0;
        font-size: 16px;
    }

    .header-info {
        margin-top: 8px;
    }

    .zone {
        font-weight: 700;
        font-size: 15px;
        padding: 4px 10px;
    }

    .time {
        font-size: 13px;
        color: #666;
        padding: 4px 10px;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
        font-weight: bold;
    }


    /* ===== SUMMARY ===== */
    .view-summary {
        background: #fff;
        padding: 12px;
        border-radius: 10px;
        margin-bottom: 12px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    }

    .view-summary table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }

    .view-summary th:first-child,
    .view-summary td:first-child {
        width: 65%;
    }

    .view-summary th:last-child,
    .view-summary td:last-child {
        width: 35%;
        text-align: right;
    }

    .system-row td {
        font-weight: 600;
        background: #f5f6f8;
        padding-top: 10px;
    }

    /* ===== DETAIL ===== */
    .view-detail {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 12px;
    }

    .view-detail h4 {
        text-align: center;
        font-size: 16px;
        font-weight: 600;
        color: #333;
        grid-column: 1 / -1;
    }

    /* ===== GROUP ===== */
    .system-group {
        background: #f9fafb;
        padding: 12px;
        border-radius: 10px;

        display: flex;
        flex-direction: column;
    }

    .system-group h4 {
        margin-bottom: 10px;
        font-size: 16px;
        font-weight: 600;
        color: #333;
    }

    /* ===== ITEM ===== */
    .detail-item {
        display: flex;
        /* 🔥 quan trọng */
        gap: 16px;
        align-items: flex-start;

        background: #fff;
        padding: 12px;
        border-radius: 10px;
        margin-bottom: 10px;

        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    }

    /* ===== TITLE ===== */
    .detail-item .title {
        min-width: 120px;
        /* 🔥 giữ cột trái cố định */
        font-weight: 600;
        color: #222;
    }

    /* ===== IMAGE CONTAINER ===== */
    .images {
        display: flex;
        flex-wrap: wrap;
        /* 🔥 tự xuống dòng khi thiếu chỗ */
        gap: 10px;
        flex: 1;
        /* 🔥 chiếm hết chiều ngang */
    }

    /* ===== IMAGE ===== */
    .thumb {
        width: 110px;
        height: 110px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #ddd;
        cursor: pointer;

        transition: transform 0.2s;
    }

    .thumb:hover {
        transform: scale(1.05);
    }

    /* ===== NOTE ===== */
    .note {
        margin-top: 8px;
        font-size: 14px;
        color: #444;
        width: 100%;
    }

    /* ===== STATUS BADGE ===== */
    .badge-ok {
        color: #1f8f3a;
    }

    .badge-fail {
        color: #d93025;
    }

    .badge-ok,
    .badge-fail {
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    /* ===== MODAL ===== */
    .img-modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.85);
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .img-modal img {
        max-width: 90%;
        max-height: 90%;
        border-radius: 10px;
    }

    .system-group {
        margin-bottom: 16px;
    }

    .system-group h3 {
        margin-bottom: 8px;
        font-size: 16px;
        color: #333;
    }

    .system-group {
        margin-bottom: 16px;
    }

    .system-title {
        margin-bottom: 8px;
        font-size: 16px;
        font-weight: 600;
    }

    .card-item {
        background: #fff;
        padding: 12px;
        border-radius: 10px;
        margin-bottom: 10px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    }

    .card-item.invalid {
        border: 2px solid #d93025;
        background: #fff5f5;
    }

    .item-title {
        font-weight: 600;
        margin-bottom: 8px;
    }

    .status-group {
        display: flex;
        gap: 10px;
        margin-top: 16px;
    }

    .btn-ok,
    .btn-fail {
        flex: 1;
        padding: 12px;
        border-radius: 6px;
        border: 1px solid #ccc;
        background: #f5f5f5;
    }

    .active-ok {
        background: #2e7d32;
        color: #fff;
    }

    .active-fail {
        background: #d32f2f;
        color: #fff;
    }

    .file-group {
        margin-bottom: 8px;
    }

    .images {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    /* Nút bấm chính */
    .btn-camera {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        background: #f0f4ff;
        border: 2px dashed #adc4ff;
        color: #4361ee;
        padding: 14px;
        border-radius: 12px;
        cursor: pointer;
        font-weight: 600;
        transition: 0.3s;
    }

    .btn-camera.success {
        background: #ecfdf5;
        border: 2px solid #10b981;
        color: #10b981;
    }

    /* Khung chứa ảnh xem trước */
    .preview-wrap {
        width: 100%;
        height: 200px;
        background: #1a1c2c;
        border-radius: 12px;
        margin-top: 15px;
        display: none;
        /* Chỉ hiện khi có ảnh */
        overflow: hidden;
        position: relative;
        cursor: pointer;
    }

    /* Quan trọng: Giúp ảnh không bị méo và thấy toàn bộ */
    .photo-output {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .zoom-icon {
        position: absolute;
        bottom: 8px;
        right: 8px;
        background: rgba(0, 0, 0, 0.6);
        color: white;
        font-size: 11px;
        padding: 4px 8px;
        border-radius: 5px;
    }

    .issue-box textarea {
        width: 100%;
        min-height: 60px;
    }

    .btn-save {
        width: 100%;
        padding: 14px;
        margin-top: 8px;
        border-radius: 12px;
        border: none;
        color: #fff;
        background: #4361ee;
        box-shadow: 0 4px 12px rgba(67, 97, 238, 0.2);
    }

    .summary-group {
        margin-bottom: 12px;
    }

    .summary-system {
        font-weight: 600;
        margin-bottom: 6px;
        color: #333;
    }

    .summary-group table {
        width: 100%;
        border-collapse: collapse;
    }

    .summary-group td {
        padding: 6px;
        border-top: 1px solid #eee;
    }

    button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    /* ===== MOBILE ===== */

    @media (max-width: 768px) {
        .thumb {
            width: 110px;
            height: 110px;
        }

        .view-detail {
            grid-template-columns: 1fr;
            /* 🔥 1 cột */
        }

        .detail-item {
            flex-direction: column;
            /* 🔥 xếp dọc */
        }

        .detail-item .title {
            min-width: unset;
        }

        .images {
            justify-content: flex-start;
        }
    }
</style>

<!-- ================= INIT ================= -->
<script src="/js/portals/tech/inspection/inspection.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        InspectionPage.initForm();
    });
</script>