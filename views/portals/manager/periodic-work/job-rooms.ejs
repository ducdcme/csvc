<div class="content">

    <div class="page-header">

        <div>
            <h1 class="page-title">
                Manage Job Rooms
            </h1>

            <p class="page-subtitle">
                Assign inspection rooms
            </p>
        </div>

    </div>



    <!-- FILTER -->
    <div class="card">

        <div class="form-grid">

            <div class="form-group">

                <label>
                    Building
                </label>

                <select id="select-building">
                    <option value="">
                        Select Building
                    </option>
                </select>

            </div>



            <div class="form-group">

                <label>
                    Floor
                </label>

                <select id="select-floor">
                    <option value="">
                        Select Floor
                    </option>
                </select>

            </div>



            <div class="form-group">

                <label>
                    Search Room
                </label>

                <input type="text" id="search-room" placeholder="Room code or room name">

            </div>

        </div>

    </div>



    <!-- ROOM LIST -->
    <div class="card">

        <div class="card-header">

            <div>
                Room List
            </div>

            <div id="selected-room-count">
                0 rooms selected
            </div>

        </div>



        <div id="room-checkbox-list" class="room-checkbox-list room-grid">

        </div>



        <div class="card-footer">

            <button id="btn-save-rooms" class="btn btn-primary">
                Save Rooms
            </button>

        </div>

    </div>



    <!-- ASSIGNED -->
    <div class="card">

        <div class="card-header">
            Assigned Rooms
        </div>

        <div id="assigned-room-list">

        </div>

    </div>

</div>

<script src="/js/portals/manager/periodic-work/job-rooms.js"></script>