<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <title>403 - Access Denied</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f8fafc;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .error-box {
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, .08);
            text-align: center;
            max-width: 500px;
        }

        h1 {
            font-size: 72px;
            margin: 0;
            color: #dc2626;
        }

        .msg {
            margin-top: 10px;
            font-size: 18px;
        }

        .permission {
            margin-top: 20px;
            color: #666;
            font-size: 14px;
        }

        a {
            display: inline-block;
            margin-top: 24px;
            text-decoration: none;
            background: #2563eb;
            color: white;
            padding: 10px 18px;
            border-radius: 8px;
        }
    </style>
</head>

<body>

    <div class="error-box">

        <h1>403</h1>

        <div class="msg">
            <%= error.message %>
        </div>

        <% if (error.requiredPermissions) { %>
            <div class="permission" hidden>
                Required:
                <%= error.requiredPermissions.join(', ') %>
            </div>
            
                    <% } %>

                        <a href="/">Quay lại trang chủ</a>


            </div>
            <script>setTimeout(() => { window.location.href = ' /' }, 2000)</script>

</body>

</html>